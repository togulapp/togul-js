{
  "name": "@togul/js",
  "version": "0.6.0",
  "description": "Official Node.js / Next.js SDK for Togul Feature Flag Service",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    },
    "./openfeature": {
      "types": "./dist/openfeature/index.d.ts",
      "import": "./dist/openfeature/index.mjs",
      "require": "./dist/openfeature/index.js"
    },
    "./edge": {
      "types": "./dist/edge/index.d.mts",
      "import": "./dist/edge/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.23.0"
  },
  "peerDependenciesMeta": {
    "@openfeature/server-sdk": {
      "optional": true
    }
  },
  "keywords": [
    "togul",
    "feature-flag",
    "feature-toggle",
    "remote-config",
    "nextjs",
    "react",
    "openfeature"
  ],
  "license": "MIT",
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "esbuild": "^0.28.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
